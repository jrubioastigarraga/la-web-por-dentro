# Copia este fichero a .env y ajusta los valores.
# En producción, define estas variables en el panel del hosting.

# Base de Moodle, sin barra final.
# Si solo usas cuestionarios exportados a JSON, pon "none".
MOODLE_URL=https://moodle.lhusurbil.eus

# Clave configurada en el plugin local_lwpd (si la usas)
MOODLE_KEY=

# Clave opcional que debe enviar el juego en la cabecera X-Api-Key
API_KEY=

# Orígenes permitidos (el dominio del juego), separados por comas
ALLOWED_ORIGINS=https://jrubioastigarraga.github.io

# Caché de respuestas en segundos
CACHE_TTL=300

# Timeout de Moodle en segundos
MOODLE_TIMEOUT=15

# Límite de peticiones por minuto y IP
RATE_LIMIT=120
